# Optional: where the page reads generated uptime data from.
# Default (unset) is the same-origin file: /monitor-data.json
#
# Set this to the raw GitHub URL if your host has tight build limits and you
# don't want every 15-minute data update to trigger a site rebuild — the page
# will then read live data without redeploying:
#
# VITE_MONITOR_DATA_URL=https://raw.githubusercontent.com/CodeByBryant/Xenith-Status/main/public/monitor-data.json
